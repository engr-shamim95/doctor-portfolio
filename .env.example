# ==============================================================================
# Doctor Personal Portfolio & Appointment System - Authoritative Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment & Server Network
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Canonical Public URL of the Web Application (No trailing slash)
# For local dev: http://localhost:3000
# For production: https://dr-portfolio.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# PostgreSQL 15+ Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/doctor_portfolio

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Payload CMS Secret Key (Required: Minimum 32 random characters)
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret for HMAC-SHA256 Signed Management & Cancellation Links (Min 32 characters)
# Defaults to PAYLOAD_SECRET if omitted, but dedicated secret is recommended
APPOINTMENT_SIGNING_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ------------------------------------------------------------------------------
# 4. One-Time Password (OTP) & Verification Configuration
# ------------------------------------------------------------------------------
# Mode: 'mock' for local dev and automated tests (logs OTP to console, code=123456)
# Mode: 'sms' for live production SMS dispatch via Bangladesh Gateway
OTP_PROVIDER=mock

# Secret key used for cryptographic SHA-256 OTP hashing before database storage
OTP_SECRET=dev-otp-hashing-secret-min-16-chars

# Time-To-Live (TTL) for reservation hold and OTP validity in seconds (Default: 300 = 5 min)
OTP_EXPIRY_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Production SMS Gateway Configuration (Required only when OTP_PROVIDER=sms)
# ------------------------------------------------------------------------------
SMS_GATEWAY_URL=https://api.sms-gateway.com/send
SMS_API_KEY=your_production_sms_api_key
SMS_SENDER_ID=DOCTORAPP

# ------------------------------------------------------------------------------
# 6. Transactional Email / SMTP (Nodemailer / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="Dr. Personal Practice"
SMTP_FROM_EMAIL=no-reply@doctorpractice.com

# ------------------------------------------------------------------------------
# 7. Localization, Timezone & Public Defaults
# ------------------------------------------------------------------------------
# Application Timezone: All calendar calculations strictly follow Asia/Dhaka (UTC+6)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dhaka

# Primary Default Locale ('bn' for Bangla, 'en' for English)
NEXT_PUBLIC_DEFAULT_LOCALE=bn

# Branding & Clinic Metadata
NEXT_PUBLIC_SITE_NAME="Dr. Specialized Clinical Care"

# Public WhatsApp Hotline (+8801XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=+8801700000000
